{
    "name": "Email Writer Assisstant",
    "desciption": "AI-Powered email reply generator",
    "version": "1.0",
    "manifest_version": "3",
    "permissions" : ["activeTab", "storage"],
    "host_permissions":["http://localhost:3000/*","*://mail.google.com"],
    "action":{
        "default_title": "Email Writer Assisstant"
    },
    "content_scripts":[
        {
            "js": ["content.js"],
            "matches": ["*://mail.google.com/*"],
            "css": ["content.css"],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icons/*"],
            "matches": ["*://mail.google.com/*"]
        }
    ]
}